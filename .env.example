# MyAgent environment template.
#
#   cp .env.example .env      # .env is git ignored, never commit real secrets
#
# Rules (docs/decision-records/0004-secrets-and-env-files.md):
#   * loaded through python-dotenv's load_dotenv(); process env vars always win
#   * a key that is present but blank counts as unset
#   * MYAGENT_ENV_FILE can point at a .env somewhere else

# ---- Runtime ---------------------------------------------------------------
# MYAGENT_ENV_FILE=/absolute/path/to/.env
MYAGENT_LOG_LEVEL=INFO
MYAGENT_LOG_FORMAT=text

# ---- LLM (Phase 2: Model Provider) -----------------------------------------
# Credential variables use the short LLM_* / EMBED_* form; project switches keep
# the MYAGENT_* prefix. Any OpenAI-compatible endpoint works.
#   LLM_PROVIDER      openai_compat (the only Phase 2 implementation)
#   LLM_MAX_TOKENS    upper bound the model may generate per request
#   LLM_CONTEXT_WINDOW  provider context limit; Phase 6 uses it for the budget
#   LLM_TEMPERATURE   sampling temperature (0 disables sampling jitter)
LLM_BASE_URL=https://<your-endpoint>/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=openai_compat
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=128000
LLM_TEMPERATURE=0.1
# Fallbacks used by provider-specific clients.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ---- Agent runtime (Phase 2: Loop / Runner) --------------------------------
#   AGENT_MAX_ITERATIONS      模型-工具循环上限，超过后做一次收尾回答
#   AGENT_TOOL_TIMEOUT_S      单个工具的超时（秒），超时转成可读工具错误
#   AGENT_MAX_TOOL_RESULT_CHARS  单条工具结果的字符上限（超出截断）
#   AGENT_WORKSPACE           read_file / search_local 允许访问的根目录
#   AGENT_SESSIONS_DIR        会话 JSONL 的存放目录
AGENT_MAX_ITERATIONS=12
AGENT_TOOL_TIMEOUT_S=30
AGENT_MAX_TOOL_RESULT_CHARS=8000
AGENT_WORKSPACE=workspace
AGENT_SESSIONS_DIR=data/sessions

# ---- Embedding (Phase 5: RAG) ----------------------------------------------
# Aliyun DashScope. Keys: https://dashscope.aliyun.com/
#   EMBED_MODEL_TYPE  dashscope | openai
#   EMBED_BASE_URL    blank = the provider's default OpenAI-compatible endpoint
#   EMBED_DIM         blank = let the service decide (probe it in Phase 5)
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=qwen3.7-text-embedding-flash
EMBED_API_KEY=
EMBED_BASE_URL=
# EMBED_DIM=

# ---- Long-term memory (Phase 4) --------------------------------------------
#   MYAGENT_MEMORY_ENABLED            false = no recall and no writes
#                                     (`memory list` still inspects the store;
#                                     `memory add` refuses instead of storing)
#   MYAGENT_MEMORY_HALF_LIFE_DAYS     episodic 记忆打分的时间衰减半衰期（天）
#   MYAGENT_MEMORY_TOP_K              how many memories one recall returns
#   MYAGENT_MEMORY_MAX_TEXT_CHARS     单条记忆的字符上限（写入层强制）
#   MYAGENT_MEMORY_MAX_RECORDS_PER_TURN  单轮最多写入几条
MYAGENT_MEMORY_ENABLED=false
MYAGENT_MEMORY_HALF_LIFE_DAYS=30
MYAGENT_MEMORY_TOP_K=5
MYAGENT_MEMORY_MAX_TEXT_CHARS=500
MYAGENT_MEMORY_MAX_RECORDS_PER_TURN=3

# ---- Document / metadata store (Phase 4-5: SQLite) -------------------------
MYAGENT_SQLITE_PATH=data/myagent.db

# ---- Vector store (Phase 5: Qdrant) ----------------------------------------
# Local docker deployment needs no API key; Qdrant Cloud needs url + key.
MYAGENT_QDRANT_URL=http://localhost:6333
MYAGENT_QDRANT_API_KEY=
# Two collections on purpose (ADR-0008): memories are deleted by id, documents
# are re-ingested wholesale.
MYAGENT_QDRANT_COLLECTION=myagent_documents
MYAGENT_QDRANT_MEMORY_COLLECTION=myagent_memories
MYAGENT_QDRANT_PREFER_GRPC=false

# Automatic document recall is optional; explicit ingest/search remain available.
MYAGENT_RAG_ENABLED=false

# ---- Optional: reranking (Phase 5.7) ---------------------------------------
COHERE_API_KEY=

# ---- Optional: web tools (Phase 7) -----------------------------------------
TAVILY_API_KEY=
